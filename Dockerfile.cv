FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# CPU-only torch отдельным шагом: на PyPI torch==2.12.1 по умолчанию тянет полный CUDA-стек
# (~5+ ГБ лишних nvidia-пакетов), бесполезный без GPU. Индекс download.pytorch.org даёт CPU-сборку.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
     torch==2.12.1 torchvision==0.27.1

COPY requirements-cv.txt .

ENV SAM2_BUILD_CUDA=0

# torch/numpy уже стоят нужной версии из шага выше — pip их не переустановит и не полезет за CUDA-версией
RUN pip install --no-cache-dir --no-build-isolation -r requirements-cv.txt

COPY services/cv/ ./services/cv/
COPY cv_server.py .

EXPOSE 8001

CMD ["uvicorn", "cv_server:app", "--host", "0.0.0.0", "--port", "8001"]